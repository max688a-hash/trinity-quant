{
  "version": 1,
  "hooks": {
    "stop": [
      {
        "command": "python3 .cursor/hooks/anti_landmine.py",
        "timeout": 60,
        "failClosed": true
      }
    ],
    "preToolUse": [
      {
        "command": "python3 .cursor/hooks/anti_landmine.py",
        "matcher": "Write|StrReplace|TabWrite",
        "timeout": 15,
        "failClosed": true
      }
    ]
  }
}
